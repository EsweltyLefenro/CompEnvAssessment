<Window x:Class="CompEnvAssessment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CompEnvAssessment.Views"
        Title="Оценка конкурентоспособности предприятия во внешней среде"
        Width="1420"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="15">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Оценка конкурентоспособности предприятия во внешней среде"
                   Style="{StaticResource PageTitleTextStyle}"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <views:InitialDataView Grid.Row="0"
                                   DataContext="{Binding InitialData}"/>

            <views:WorkspaceView Grid.Row="2"
                                 DataContext="{Binding Workspace}"/>
        </Grid>
    </Grid>
</Window>