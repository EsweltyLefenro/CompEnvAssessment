<UserControl x:Class="CompEnvAssessment.Views.FactorsStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:CompEnvAssessment.Behaviors">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Факторы и веса"
                           Style="{StaticResource SectionTitleTextStyle}"/>

                <TextBlock Text="Добавьте от 3 до 20 факторов конкурентоспособности. Сумма весов должна быть равна 1,00."
                           Style="{StaticResource SmallCaptionTextStyle}"
                           Margin="0 4 0 0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ Добавить фактор"
                    Command="{Binding AddFactorCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 0 0 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Название фактора"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>

                <TextBlock Grid.Column="1"
                           Text="Вес"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text=""
                           FontWeight="SemiBold"/>
            </Grid>

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Factors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Введите фактор, влияющий на конкурентоспособность предприятия."/>

                            <TextBox Grid.Column="1"
                                     behaviors:FactorWeightTextBoxBehavior.IsEnabled="True"
                                     Margin="10 0 10 0"
                                     HorizontalContentAlignment="Right"
                                     ToolTip="Введите вес в формате 0,00. Сумма всех весов должна быть равна 1,00."/>

                            <Button Grid.Column="2"
                                    Content="×"
                                    Command="{Binding DataContext.RemoveFactorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    FontSize="18"
                                    Padding="0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="4"
                Background="#F8FAFC"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Сумма весов"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Для перехода дальше сумма должна быть равна 1,00, а каждый фактор должен иметь положительный вес."
                               Style="{StaticResource SmallCaptionTextStyle}"
                               Margin="0 3 0 0"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding TotalWeight, StringFormat={}{0:0.00}}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
