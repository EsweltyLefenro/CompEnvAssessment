<UserControl x:Class="CompEnvAssessment.Views.StrategyMapsStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>
		<Style x:Key="PairListPanelStyle" TargetType="Grid">
			<Setter Property="Visibility" Value="Visible"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsPairListVisible}" Value="False">
					<Setter Property="Visibility" Value="Collapsed"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="PairDetailsPanelStyle" TargetType="Grid">
			<Setter Property="Visibility" Value="Collapsed"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsPairDetailsVisible}" Value="True">
					<Setter Property="Visibility" Value="Visible"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="MapPointEllipseStyle" TargetType="Ellipse">
			<Setter Property="Fill" Value="#2563EB"/>
			<Setter Property="Stroke" Value="White"/>
			<Setter Property="StrokeThickness" Value="2"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsUserCompany}" Value="True">
					<Setter Property="Fill" Value="#1E3A8A"/>
					<Setter Property="Stroke" Value="#F59E0B"/>
					<Setter Property="StrokeThickness" Value="3"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="MapGridLineStyle" TargetType="Line">
			<Setter Property="Stroke" Value="#E2E8F0"/>
			<Setter Property="StrokeThickness" Value="1"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
		</Style>

		<Style x:Key="MapAxisLineStyle" TargetType="Line" BasedOn="{StaticResource MapGridLineStyle}">
			<Setter Property="Stroke" Value="#334155"/>
			<Setter Property="StrokeThickness" Value="2"/>
		</Style>
	</UserControl.Resources>

	<Grid>
		<Grid Style="{StaticResource PairListPanelStyle}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="14"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="14"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0">
				<TextBlock Text="Карты стратегической группировки"
                           Style="{StaticResource SectionTitleTextStyle}"/>

				<TextBlock Text="Выберите пару факторов, откройте карту и заполните вывод. Если по паре нет содержательного вывода, отметьте это в карточке карты."
                           Style="{StaticResource SmallCaptionTextStyle}"
                           Margin="0 6 0 0"/>
			</StackPanel>

			<Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock Text="Всего пар"
                                   Style="{StaticResource SmallCaptionTextStyle}"/>
						<TextBlock Text="{Binding TotalPairsCount}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
					</StackPanel>

					<StackPanel Grid.Column="1">
						<TextBlock Text="Обработано"
                                   Style="{StaticResource SmallCaptionTextStyle}"/>
						<TextBlock Text="{Binding CompletedPairsCount}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<TextBlock Text="Текстовых выводов"
								   Style="{StaticResource SmallCaptionTextStyle}"/>

						<TextBlock Text="{Binding TextConclusionsProgressText}"
								   FontSize="22"
								   FontWeight="SemiBold"
								   Foreground="{StaticResource PrimaryTextBrush}"/>
					</StackPanel>
				</Grid>
			</Border>

			<ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Auto">
				<ItemsControl ItemsSource="{Binding PairItems}"
                              Margin="0 0 10 0">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Command="{Binding DataContext.OpenPairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0 0 0 10"
                                    Padding="14">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="42"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="180"/>
									</Grid.ColumnDefinitions>

									<TextBlock Text="{Binding StatusMark}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>

									<StackPanel Grid.Column="1">
										<TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>

										<TextBlock Text="Нажмите, чтобы открыть карту и заполнить вывод."
                                                   Style="{StaticResource SmallCaptionTextStyle}"
                                                   Margin="0 3 0 0"/>
									</StackPanel>

									<TextBlock Grid.Column="2"
                                               Text="{Binding StatusText}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
								</Grid>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>

		<Grid Style="{StaticResource PairDetailsPanelStyle}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="14"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="14"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0">
				<TextBlock Text="{Binding SelectedPairTitle}"
                           Style="{StaticResource SectionTitleTextStyle}"/>

				<TextBlock Text="Слева показана карта стратегической группировки. Справа заполните вывод по выбранной паре факторов."
                           Style="{StaticResource SmallCaptionTextStyle}"
                           Margin="0 6 0 0"/>
			</StackPanel>

			<Grid Grid.Row="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="560"/>
					<ColumnDefinition Width="22"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14">
					<ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
						<Grid Margin="0 0 10 0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="14"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="12"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<TextBlock Grid.Row="0"
                                   Text="Карта стратегической группировки"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

						<Grid Grid.Row="2"
                              Width="500"
                              Height="500"
                              HorizontalAlignment="Center">
							<Canvas Width="440"
                                    Height="440"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="White">

								<Line X1="0" Y1="0" X2="440" Y2="0"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="0" Y1="44" X2="440" Y2="44"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="0" Y1="88" X2="440" Y2="88"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="0" Y1="132" X2="440" Y2="132"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="0" Y1="176" X2="440" Y2="176"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="0" Y1="220" X2="440" Y2="220"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="0" Y1="264" X2="440" Y2="264"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="0" Y1="308" X2="440" Y2="308"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="0" Y1="352" X2="440" Y2="352"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="0" Y1="396" X2="440" Y2="396"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="0" Y1="440" X2="440" Y2="440"
                                      Style="{StaticResource MapAxisLineStyle}"/>

								<Line X1="0" Y1="0" X2="0" Y2="440"
                                      Style="{StaticResource MapAxisLineStyle}"/>
								<Line X1="44" Y1="0" X2="44" Y2="440"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="88" Y1="0" X2="88" Y2="440"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="132" Y1="0" X2="132" Y2="440"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="176" Y1="0" X2="176" Y2="440"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="220" Y1="0" X2="220" Y2="440"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="264" Y1="0" X2="264" Y2="440"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="308" Y1="0" X2="308" Y2="440"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="352" Y1="0" X2="352" Y2="440"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="396" Y1="0" X2="396" Y2="440"
                                      Style="{StaticResource MapGridLineStyle}"/>
								<Line X1="440" Y1="0" X2="440" Y2="440"
                                      Style="{StaticResource MapGridLineStyle}"/>

								<TextBlock Canvas.Left="17"
                                           Canvas.Top="444"
                                           Text="1"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

								<TextBlock Canvas.Left="410"
                                           Canvas.Top="444"
                                           Text="10"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

								<TextBlock Canvas.Left="-22"
                                           Canvas.Top="410"
                                           Text="1"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

								<TextBlock Canvas.Left="-28"
                                           Canvas.Top="14"
                                           Text="10"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

								<ItemsControl ItemsSource="{Binding SelectedPairPoints}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<Canvas/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>

									<ItemsControl.ItemContainerStyle>
										<Style TargetType="ContentPresenter">
											<Setter Property="Canvas.Left" Value="{Binding Left}"/>
											<Setter Property="Canvas.Top" Value="{Binding Top}"/>
										</Style>
									</ItemsControl.ItemContainerStyle>

									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid ToolTip="{Binding Label}">
												<Ellipse Width="{Binding Size}"
                                                         Height="{Binding Size}"
                                                         Style="{StaticResource MapPointEllipseStyle}"/>

												<TextBlock Text="{Binding CompanyName}"
                                                           Margin="0 -20 0 0"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Top"/>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Canvas>
						</Grid>

						<Grid Grid.Row="4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<TextBlock Text="{Binding SelectedXAxisTitle, StringFormat=Ось X: {0}}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource SmallCaptionTextStyle}"/>

							<TextBlock Grid.Column="1"
                                       Text="{Binding SelectedYAxisTitle, StringFormat=Ось Y: {0}}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource SmallCaptionTextStyle}"
                                       Margin="14 0 0 0"/>
						</Grid>
						</Grid>
					</ScrollViewer>
				</Border>

				<Border Grid.Column="2"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="18">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="14"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<CheckBox Grid.Row="0"
                                  IsChecked="{Binding SelectedPairItem.IsSkipped, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  ToolTip="Используйте этот вариант только если по сочетанию факторов действительно нельзя сделать содержательный вывод.">
							<TextBlock Text="По данной паре факторов вывод не требуется"
                                       TextWrapping="Wrap"/>
						</CheckBox>

						<TextBox Grid.Row="2"
                                 Text="{Binding SelectedPairItem.Conclusion, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Visible"
                                 VerticalContentAlignment="Top"
                                 MinHeight="220"
                                 Padding="12 10 20 10"
                                 ToolTip="Опишите, какое положение занимают компании на карте и какие выводы можно сделать."/>
					</Grid>
				</Border>
			</Grid>

			<Button Grid.Row="4"
                    Content="← Назад к списку пар"
                    Command="{Binding BackToPairsListCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Left"/>
		</Grid>
	</Grid>
</UserControl>
