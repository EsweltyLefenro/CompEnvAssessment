<UserControl x:Class="CompEnvAssessment.Views.CompanyRatingStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="14"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="14"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel>
				<TextBlock Text="Оценка компаний"
                           Style="{StaticResource SectionTitleTextStyle}"/>

				<TextBlock Text="{Binding CompetitorsLimitText, StringFormat=Укажите долю рынка и оценки компаний по каждому фактору. Оценки вводятся по шкале от 1 до 10. {0}}"
                           Style="{StaticResource SmallCaptionTextStyle}"
                           Margin="0 4 0 0"/>
			</StackPanel>

			<Button Grid.Column="1"
                    Content="+ Добавить конкурента"
                    Command="{Binding AddCompetitorCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
		</Grid>

		<ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
			<StackPanel MinWidth="1000">

				<Grid Margin="0 0 0 10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="320"/>
						<ColumnDefinition Width="110"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12 0 0 12"
                            Padding="12">
						<TextBlock Text="Фактор"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
					</Border>

					<Border Grid.Column="1"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            Padding="12">
						<TextBlock Text="Вес"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
					</Border>

					<ItemsControl Grid.Column="2"
                                  ItemsSource="{Binding CompanyColumns}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Width="210"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        Padding="10"
                                        Margin="-1 0 0 0">
									<StackPanel>
										<TextBlock Text="{Binding ColumnCaption}"
                                                   Style="{StaticResource SmallCaptionTextStyle}"/>

										<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsNameReadOnly}"
                                                 ToolTip="{Binding NameToolTip}"/>

										<TextBlock Text="Доля рынка, %"
                                                   Style="{StaticResource SmallCaptionTextStyle}"
                                                   Margin="0 8 0 0"/>

										<TextBox Text="{Binding MarketShare, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                 HorizontalContentAlignment="Right"
                                                 ToolTip="Доля рынка влияет на размер маркера компании на карте."/>

										<TextBlock Text="{Binding WeightedRating, StringFormat=Рейтинг: {0:0.00}}"
                                                   Margin="0 8 0 0"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}"/>

										<Button Content="Удалить"
                                                Command="{Binding DataContext.RemoveCompetitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Margin="0 10 0 0"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Grid>

				<ItemsControl ItemsSource="{Binding RatingRows}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid Margin="0 0 0 8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="320"/>
									<ColumnDefinition Width="110"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<Border Grid.Column="0"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10 0 0 10"
                                        Padding="12">
									<TextBlock Text="{Binding FactorName}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
								</Border>

								<Border Grid.Column="1"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        Padding="12">
									<TextBlock Text="{Binding Weight, StringFormat={}{0:0.00}}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>
								</Border>

								<ItemsControl Grid.Column="2"
                                              ItemsSource="{Binding Cells}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>

									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Width="210"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    Padding="10"
                                                    Margin="-1 0 0 0">
												<TextBox Text="{Binding Score, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         HorizontalContentAlignment="Right"
                                                         ToolTip="Введите оценку от 1 до 10."/>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="4"
                Background="#F8FAFC"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel>
					<TextBlock Text="Оцениваемая доля рынка"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

					<TextBlock Text="Оцениваемая доля рынка всех компаний не должна превышать 100%."
                               Style="{StaticResource SmallCaptionTextStyle}"
                               Margin="0 3 0 0"/>
				</StackPanel>

				<TextBlock Grid.Column="1"
                           Text="{Binding AssessedMarketShare, StringFormat={}{0:0.00}%}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           VerticalAlignment="Center"/>
			</Grid>
		</Border>
	</Grid>
</UserControl>
