<UserControl x:Class="CompEnvAssessment.Views.CompanyRatingStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Оценка компаний"
                   Style="{StaticResource SectionTitleTextStyle}"/>

        <TextBlock Text="Здесь будет таблица оценок собственного предприятия и конкурентов по выбранным факторам."
                   Style="{StaticResource SmallCaptionTextStyle}"
                   Margin="0 6 0 18"/>

        <Button Content="+ Добавить конкурента"
                Command="{Binding AddCompetitorCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Left"/>

        <ItemsControl ItemsSource="{Binding Companies}"
                      Margin="0 18 0 0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0 0 0 10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Название компании"
                                           Style="{StaticResource SmallCaptionTextStyle}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12 0 0 0">
                                <TextBlock Text="Доля рынка, %"
                                           Style="{StaticResource SmallCaptionTextStyle}"/>
                                <TextBox Text="{Binding MarketShare, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Right"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="Оценки по факторам добавим следующим шагом."
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="18 0 0 0"/>

                            <Button Grid.Column="3"
                                    Content="Удалить"
                                    Command="{Binding DataContext.RemoveCompetitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="14 0 0 0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>