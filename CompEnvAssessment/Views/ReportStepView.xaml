<UserControl x:Class="CompEnvAssessment.Views.ReportStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="14"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="14"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0">
			<TextBlock Text="Отчёт"
                       Style="{StaticResource SectionTitleTextStyle}"/>

			<TextBlock Text="Проверьте готовность данных и структуру будущего отчёта, затем сформируйте PDF-файл."
                       Style="{StaticResource SmallCaptionTextStyle}"
                       Margin="0 6 0 0"/>
		</StackPanel>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="0.95*"/>
				<ColumnDefinition Width="18"/>
				<ColumnDefinition Width="1.15*"/>
			</Grid.ColumnDefinitions>

			<!-- Левая часть: проверки -->
			<Border Grid.Column="0"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="12"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="12"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0">
						<TextBlock Text="Проверка готовности"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

						<TextBlock Text="{Binding ReportStatusText}"
                                   Style="{StaticResource SmallCaptionTextStyle}"
                                   Margin="0 4 0 0"/>
					</StackPanel>

					<Button Grid.Row="2"
                            Content="Обновить проверку"
                            Command="{Binding RefreshReportStateCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"/>

					<ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding Checks}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="White"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0 0 0 10">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="38"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>

											<TextBlock Text="{Binding StatusMark}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"/>

											<StackPanel Grid.Column="1">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>

													<TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryTextBrush}"/>

													<TextBlock Grid.Column="1"
                                                               Text="{Binding StatusText}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="12"
                                                               Margin="12 0 0 0"/>
												</Grid>

												<TextBlock Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource SmallCaptionTextStyle}"
                                                           Margin="0 4 0 0"/>

												<ItemsControl ItemsSource="{Binding Errors}"
                                                              Margin="0 8 0 0">
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<TextBlock Text="{Binding}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource DangerBrush}"
                                                                       Margin="0 2 0 0"/>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>

			<!-- Правая часть: предпросмотр структуры -->
			<Border Grid.Column="2"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="12"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0">
						<TextBlock Text="Предпросмотр содержания"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

						<TextBlock Text="Здесь показано, какие данные будут включены в итоговый отчёт."
                                   Style="{StaticResource SmallCaptionTextStyle}"
                                   Margin="0 4 0 0"/>
					</StackPanel>

					<ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding PreviewSections}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="White"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0 0 0 10">
										<StackPanel>
											<TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>

											<TextBlock Text="{Binding Body}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       Margin="0 8 0 0"
                                                       LineHeight="20"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>

		<Border Grid.Row="4"
                Background="#F8FAFC"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="12"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<TextBlock Text="{Binding ReportMessage}"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

				<Button Grid.Column="1"
                        Content="Обновить"
                        Command="{Binding RefreshReportStateCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>

				<Button Grid.Column="3"
                        Content="Сформировать PDF"
                        Command="{Binding BuildReportCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
			</Grid>
		</Border>
	</Grid>
</UserControl>
