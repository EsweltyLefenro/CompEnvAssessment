<UserControl x:Class="CompEnvAssessment.Views.ReportStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Отчёт"
                   Style="{StaticResource SectionTitleTextStyle}"/>

        <TextBlock Text="Проверьте готовность данных. Генерацию PDF добавим после завершения основных экранов."
                   Style="{StaticResource SmallCaptionTextStyle}"
                   Margin="0 6 0 18"/>

        <Button Content="Проверить готовность"
                Command="{Binding CheckReportReadinessCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Left"/>

        <ItemsControl ItemsSource="{Binding ReportErrors}"
                      Margin="0 18 0 0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0 0 0 6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>