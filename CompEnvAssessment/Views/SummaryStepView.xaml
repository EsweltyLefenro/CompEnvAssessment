<UserControl x:Class="CompEnvAssessment.Views.SummaryStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Итоги"
                       Style="{StaticResource SectionTitleTextStyle}"/>

            <TextBlock Text="Сформулируйте общий вывод о конкурентоспособности предприятия и направлениях развития."
                       Style="{StaticResource SmallCaptionTextStyle}"
                       Margin="0 6 0 0"/>
        </StackPanel>

        <TextBox Grid.Row="2"
                 Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 MinHeight="360"/>
    </Grid>
</UserControl>