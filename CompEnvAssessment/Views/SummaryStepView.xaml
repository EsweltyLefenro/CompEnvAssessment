<UserControl x:Class="CompEnvAssessment.Views.SummaryStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="14"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0">
			<TextBlock Text="Итоги"
                       Style="{StaticResource SectionTitleTextStyle}"/>

			<TextBlock Text="Слева показаны промежуточные выводы по картам стратегической группировки. Справа сформулируйте общий стратегический вывод."
                       Style="{StaticResource SmallCaptionTextStyle}"
                       Margin="0 6 0 0"/>
		</StackPanel>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.15*"/>
				<ColumnDefinition Width="18"/>
				<ColumnDefinition Width="1*"/>
			</Grid.ColumnDefinitions>

			<!-- Левая часть: промежуточные выводы -->
			<Border Grid.Column="0"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="10"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="12"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0">
						<TextBlock Text="Промежуточные выводы"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

						<TextBlock Text="Эти выводы редактируются на вкладке «Карты стратегической группировки»."
                                   Style="{StaticResource SmallCaptionTextStyle}"
                                   Margin="0 4 0 0"/>
					</StackPanel>

					<Border Grid.Row="2"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
						<TextBlock Text="{Binding IntermediateConclusionsCounterText}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
					</Border>

					<ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding IntermediateConclusions}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="White"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0 0 0 10">
										<StackPanel>
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>

												<TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"/>

												<TextBlock Grid.Column="1"
                                                           Text="{Binding StatusText}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontSize="12"
                                                           Margin="12 0 0 0"/>
											</Grid>

											<TextBlock Text="{Binding DisplayText}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       Margin="0 8 0 0"
                                                       LineHeight="20"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>

			<!-- Правая часть: финальный вывод -->
			<Border Grid.Column="2"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="12"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0">
						<TextBlock Text="Финальный стратегический вывод"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

						<TextBlock Text="Объедините промежуточные выводы в единую оценку конкурентоспособности предприятия и предложите общую стратегию развития."
                                   Style="{StaticResource SmallCaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0 4 0 0"/>
					</StackPanel>

					<TextBox Grid.Row="2"
                             Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             MinHeight="420"
                             Padding="12"
                             ToolTip="Сформулируйте общий вывод: позиция предприятия, сильные и слабые стороны, основные риски и направления развития."/>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>